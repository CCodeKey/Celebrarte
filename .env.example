# Copie para .env (na raiz do projeto) antes de rodar docker compose up

# Banco PostgreSQL do container "db". Os dados ficam no volume "pgdata".
# Usuário e senha só valem na primeira subida: depois que o volume existe,
# mudá-los aqui não altera o banco (veja o README).
POSTGRES_DB=celebrarte
POSTGRES_USER=celebrarte
POSTGRES_PASSWORD=SENHA_DO_BD

# Porta do banco na sua máquina (só 127.0.0.1), para psql/DBeaver ou rodar a API fora do Docker
POSTGRES_PORT=5433

# Mínimo de 32 caracteres
JWT_SECRET=SEGREDO_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRACAO_MINUTOS=60

# Porta em que o site fica disponível (http://localhost:80)
FRONTEND_PORT=80
