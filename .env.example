# Copie para .env (na raiz do projeto) antes de rodar docker compose up

# Banco PostgreSQL externo. Use o IP ou nome da máquina do banco: dentro do
# container, "localhost" é o próprio container, não a sua máquina
SPRING_DATASOURCE_URL=jdbc:postgresql://IP_DO_BANCO:5432/celebrarte
SPRING_DATASOURCE_USERNAME=USER_DO_BD
SPRING_DATASOURCE_PASSWORD=SENHA_DO_BD

# Mínimo de 32 caracteres
JWT_SECRET=SEGREDO_COM_PELO_MENOS_32_CARACTERES
JWT_EXPIRACAO_MINUTOS=60

# Porta em que o site fica disponível (http://localhost:80)
FRONTEND_PORT=80
